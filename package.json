{
  "name": "whoop-mcp",
  "version": "0.2.0",
  "description": "Remote MCP server for WHOOP on Cloudflare Workers: OAuth 2.1, read-only tools, signed webhooks",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vicens-aniol/whoop-mcp.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:local": "wrangler deploy -c wrangler.local.jsonc",
    "cf-typegen": "wrangler types --strict-vars=false",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.24.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
